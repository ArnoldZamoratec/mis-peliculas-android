<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/netflix_black">

    <!-- Top Netflix Header Bar -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/netflix_black"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTituloHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/containerUserActions"
            android:text="@string/app_name"
            android:textColor="@color/netflix_red"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- User Profile & Actions on right -->
        <LinearLayout
            android:id="@+id/containerUserActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBuscarHeader"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_search"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Buscar"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/netflix_text_white" />

            <ImageView
                android:id="@+id/imgAvatarProfile"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_person"
                android:background="@drawable/bg_header_button"
                android:padding="5dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Perfil"
                app:tint="@color/netflix_text_white" />

            <LinearLayout
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_header_button"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/netflix_red"
                    android:contentDescription="@string/main_logout" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/main_btn_salir"
                    android:textColor="@color/netflix_red"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-bold" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <!-- Real-time Movie Search Bar -->
    <LinearLayout
        android:id="@+id/containerSearchBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_search_hint"
            android:textColorHint="@color/netflix_text_hint"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/netflix_text_secondary"
            app:boxBackgroundColor="@color/netflix_card"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="@color/netflix_red"
            app:hintTextColor="@color/netflix_red">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBuscarPelicula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/netflix_text_white"
                android:textSize="14sp"
                android:minHeight="44dp" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Genre Filter Horizontal Scroll -->
    <HorizontalScrollView
        android:id="@+id/scrollFiltros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/containerSearchBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupGeneros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todas"
                android:checked="true"
                app:chipBackgroundColor="@color/netflix_red"
                android:textColor="@color/netflix_text_white" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAccion"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acción"
                app:chipBackgroundColor="@color/netflix_card"
                android:textColor="@color/netflix_text_white" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSciFi"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sci-Fi"
                app:chipBackgroundColor="@color/netflix_card"
                android:textColor="@color/netflix_text_white" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDrama"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drama"
                app:chipBackgroundColor="@color/netflix_card"
                android:textColor="@color/netflix_text_white" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAnimacion"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Animación"
                app:chipBackgroundColor="@color/netflix_card"
                android:textColor="@color/netflix_text_white" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- Empty State View -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollFiltros"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_movie"
            android:contentDescription="Sin películas"
            app:tint="@color/netflix_input_focused" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_empty_title"
            android:textColor="@color/netflix_text_white"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_empty_subtitle"
            android:textColor="@color/netflix_text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- RecyclerView for Movie Cards -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPeliculas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/scrollFiltros"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Netflix Red FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAgregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:contentDescription="@string/cd_agregar_pelicula"
        android:src="@drawable/ic_add"
        app:tint="@color/netflix_text_white"
        app:backgroundTint="@color/netflix_red"
        app:fabSize="normal"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Fragment Overlay container for Modal sheet -->
    <FrameLayout
        android:id="@+id/contenedorFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#D9000000"
        android:elevation="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>