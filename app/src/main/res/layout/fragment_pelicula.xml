<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#D9000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_login_card"
            android:padding="24dp"
            android:elevation="8dp">

            <!-- Form Header Title -->
            <TextView
                android:id="@+id/txtTituloFormulario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_nueva_pelicula"
                android:textColor="@color/netflix_text_white"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="20dp" />

            <!-- Movie Poster Selector Frame -->
            <LinearLayout
                android:id="@+id/containerSeleccionarImagen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_netflix_input"
                android:padding="12dp"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true">

                <androidx.cardview.widget.CardView
                    android:layout_width="60dp"
                    android:layout_height="85dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/netflix_black">

                    <ImageView
                        android:id="@+id/imgPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/poster_generico"
                        android:contentDescription="Vista previa imagen" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/txtEditarImagen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Imagen de Portada"
                        android:textColor="@color/netflix_text_white"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toca para seleccionar de la galería"
                        android:textColor="@color/netflix_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnEditarImagen"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Editar imagen"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/netflix_red"
                    android:background="?attr/selectableItemBackgroundBorderless" />

            </LinearLayout>

            <!-- Title Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTitulo"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="@string/hint_titulo"
                android:textColorHint="@color/netflix_text_hint"
                app:counterEnabled="true"
                app:counterMaxLength="50"
                app:counterTextColor="@color/netflix_text_secondary"
                app:boxBackgroundColor="@color/netflix_input"
                app:boxCornerRadiusBottomEnd="6dp"
                app:boxCornerRadiusBottomStart="6dp"
                app:boxCornerRadiusTopEnd="6dp"
                app:boxCornerRadiusTopStart="6dp"
                app:boxStrokeColor="@color/netflix_red"
                app:hintTextColor="@color/netflix_red">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLength="50"
                    android:textColor="@color/netflix_text_white"
                    android:textSize="15sp"
                    android:minHeight="48dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Year Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAnio"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="@string/hint_anio"
                android:textColorHint="@color/netflix_text_hint"
                app:boxBackgroundColor="@color/netflix_input"
                app:boxCornerRadiusBottomEnd="6dp"
                app:boxCornerRadiusBottomStart="6dp"
                app:boxCornerRadiusTopEnd="6dp"
                app:boxCornerRadiusTopStart="6dp"
                app:boxStrokeColor="@color/netflix_red"
                app:hintTextColor="@color/netflix_red">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAnio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="4"
                    android:textColor="@color/netflix_text_white"
                    android:textSize="15sp"
                    android:minHeight="48dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Genre Spinner Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/etiqueta_seleccionar_genero"
                android:textColor="@color/netflix_text_white"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="6dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_netflix_input"
                android:layout_marginBottom="14dp"
                android:paddingHorizontal="8dp">

                <Spinner
                    android:id="@+id/spinnerGenero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:entries="@array/array_generos"
                    android:spinnerMode="dropdown"
                    android:textColor="@color/netflix_text_white" />

            </FrameLayout>

            <!-- Video Stream URL Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilVideoUrl"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="@string/hint_video_url"
                android:textColorHint="@color/netflix_text_hint"
                app:boxBackgroundColor="@color/netflix_input"
                app:boxCornerRadiusBottomEnd="6dp"
                app:boxCornerRadiusBottomStart="6dp"
                app:boxCornerRadiusTopEnd="6dp"
                app:boxCornerRadiusTopStart="6dp"
                app:boxStrokeColor="@color/netflix_red"
                app:hintTextColor="@color/netflix_red">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVideoUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:textColor="@color/netflix_text_white"
                    android:textSize="14sp"
                    android:minHeight="48dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Rating Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/etiqueta_calificacion"
                android:textColor="@color/netflix_text_white"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <!-- RatingBar -->
            <RatingBar
                android:id="@+id/ratingCalificacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="1"
                android:rating="4"
                android:progressTint="@color/gold_star"
                android:progressBackgroundTint="@color/netflix_input_focused"
                android:layout_marginBottom="24dp" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_guardar_pelicula"
                android:textColor="@color/netflix_text_white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:backgroundTint="@color/netflix_red"
                app:cornerRadius="6dp" />

            <!-- Cancel Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_cancelar"
                android:textColor="@color/netflix_text_secondary"
                android:textSize="15sp"
                app:strokeColor="@color/netflix_input_focused"
                app:cornerRadius="6dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>