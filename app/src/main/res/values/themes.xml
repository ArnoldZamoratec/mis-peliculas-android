<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Dark Netflix Cinematic Style -->
    <style name="Base.Theme.MisPeliculas" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/netflix_red</item>
        <item name="colorOnPrimary">@color/netflix_text_white</item>
        <item name="colorSecondary">@color/netflix_dark_red</item>
        <item name="android:statusBarColor">@color/netflix_black</item>
        <item name="android:windowBackground">@color/netflix_black</item>
        <item name="android:textColorPrimary">@color/netflix_text_white</item>
        <item name="android:textColorSecondary">@color/netflix_text_secondary</item>
        <item name="materialAlertDialogTheme">@style/MaterialAlertDialog.MisPeliculas</item>
    </style>

    <style name="MaterialAlertDialog.MisPeliculas" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/netflix_card</item>
        <item name="colorSurface">@color/netflix_card</item>
        <item name="colorOnSurface">@color/netflix_text_white</item>
        <item name="colorPrimary">@color/netflix_red</item>
    </style>

    <style name="Theme.MisPeliculas" parent="Base.Theme.MisPeliculas" />
</resources>